{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webseries",
  "compatibility_date": "2024-09-23",
  "main": "_worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "US_RELAY",
        "class_name": "UsRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UsRelay"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
